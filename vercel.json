{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hkg1"],
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "functions": {
    "src/app/api/reception/upload-photo/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/documents/upload/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/documents/[id]/render/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/documents/generate/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/deadline-reminder",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/check-deadlines",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/backup-major-projects",
      "schedule": "0 2 * * 1"
    }
  ]
}
