# ============================================================
# Momenta LPA Platform — 环境变量配置
# 复制本文件��� .env.local 并填入真实值（.env.local 已在 .gitignore 中）
# ============================================================

# ── 数据库 ────────────────────────────────────────────────────
# 生产环境 PostgreSQL（部署于公司 VPC）
DATABASE_URL="postgresql://pa_user:CHANGE_ME@localhost:5432/pa_platform?schema=public"

# 本地开发可切换 SQLite（修改 schema.prisma provider 为 sqlite）
# DATABASE_URL="file:./dev.db"

# ── 应用 ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── NextAuth.js ───────────────────────────────────────────────
# 生产环境必须使用强随机密钥: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# ── 飞书 (Lark) 应用凭证 ──────────────────────────────────────
# 在飞书开发者后台创建企业自建应用后获取
FEISHU_APP_ID="cli_CHANGE_ME"
FEISHU_APP_SECRET="CHANGE_ME"
# 飞书机器人 Webhook（发送任务通知卡片）
FEISHU_BOT_WEBHOOK="https://open.feishu.cn/open-apis/bot/v2/hook/CHANGE_ME"
# 政府接待「发送通知」目标群聊 ID（oc_ 开头，在飞书群聊设置中查看）
# 若需发往多个群，用英文逗号分隔：oc_xxx,oc_yyy
FEISHU_RECEPTION_NOTIFY_CHAT_ID="oc_CHANGE_ME"

# ── ABP 内部 AI 网关配置 ─────────────────────────────────────
# ABP 平台生成的虚拟账号 Key
ABP_LLM_API_KEY="CHANGE_ME"
# ABP 手册上的接口基础地址（OpenAI 兼容格式）
ABP_LLM_BASE_URL="CHANGE_ME"
# ABP 平台支持的模型名称
ABP_MODEL_NAME="CHANGE_ME"

# ── 加密（高机密指标 AES-256-GCM）────────────────────────────
# 32 字节十六进制密钥: openssl rand -hex 32
ASSET_ENCRYPTION_KEY="CHANGE_ME_32_BYTE_HEX_KEY"

# ── 文件存储 ──────────────────────────────────────────────────
# Word 模板与生成文档存储路径（本地开发）
UPLOAD_DIR="./uploads"
# 生产环境可改为 S3/OSS 路径
# STORAGE_TYPE="s3"
# S3_BUCKET="pa-platform-docs"
