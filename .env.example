# ============================================================
# PA-Platform 环境变量配置 — Vercel 生产部署模板
#
# 本地开发：复制为 .env.local 并填入本地值（.env.local 已在 .gitignore）
# 生产部署：把每一项填到 Vercel Dashboard → Settings → Environment Variables
#
# ⚠️ 重新生成密钥步骤：见 SECRET_ROTATION.md
# ⚠️ 文件存储方案选择：见 STORAGE_ON_VERCEL.md
# ============================================================

# ── 数据库（生产：Neon / Supabase / Vercel Postgres / 自建） ──
# Neon 示例：postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/pa_platform?sslmode=require
# 必须带 ?sslmode=require，否则连接会被拒绝
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pa_platform?sslmode=require"

# ── 应用 URL（Vercel 会自动给 https://xxx.vercel.app） ─────────
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
# NODE_ENV 由 Vercel 自动注入为 "production"，**不要**手动设置

# ── NextAuth.js（必须重新生成密钥，详见 SECRET_ROTATION.md） ──
# 生成命令：openssl rand -base64 32
NEXTAUTH_SECRET="GENERATE_NEW_SECRET_HERE"
NEXTAUTH_URL="https://your-app.vercel.app"

# ── 飞书集成（可选，飞书 SSO 启用时必填） ──────────────────────
# 在 https://open.feishu.cn/app 创建应用后获取
FEISHU_APP_ID="cli_xxx"
FEISHU_APP_SECRET="xxx"
# 飞书机器人 Webhook（任务通知卡片）
FEISHU_BOT_WEBHOOK="https://open.feishu.cn/open-apis/bot/v2/hook/xxx"
# 政府接待「发送通知」目标群聊 ID（oc_ 开头，可多个用逗号分隔）
FEISHU_RECEPTION_NOTIFY_CHAT_ID="oc_xxx"

# ── AI 网关（可选） ─────────────────────────────────────────────
ABP_LLM_API_KEY="sk-xxx"
ABP_LLM_BASE_URL="https://api.example.com/v1"
ABP_MODEL_NAME="model-name"

# ── 资产加密密钥（**重新生成**，详见 SECRET_ROTATION.md） ───
# 生成命令：openssl rand -hex 32
ASSET_ENCRYPTION_KEY="GENERATE_NEW_KEY_HERE"

# ── 文件存储（Vercel 上必须用外部存储） ─────────────────────────
# 方案 A（推荐）：Vercel Blob（详见 STORAGE_ON_VERCEL.md）
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
# 方案 B（演示用）：保持本地路径——⚠️ Vercel 上传重启即丢失，不可用
# UPLOAD_DIR="./uploads"

# ── 虚拟登录账号密码（演示用，建议保留本地 .env.local） ─────────
ADMIN_PASSWORD="GENERATE_STRONG_PASSWORD"
