{
  "name": "pa-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env --import=tsx/esm prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:init-sql": "psql $DATABASE_URL -f prisma/sql/init.sql",
    "backup:start": "node auto-backup.js"
  },
  "prisma": {
    "seed": "node --env-file=.env --import=tsx/esm prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hello-pangea/dnd": "^18.0.1",
    "@libsql/client": "^0.17.3",
    "@mendable/firecrawl-js": "^4.0.0",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@supabase/supabase-js": "^2.105.3",
    "@upstash/qstash": "^2.11.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.6.1",
    "docxtemplater": "^3.68.6",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-auth": "^4.24.14",
    "node-cron": "^4.5.0",
    "openai": "^6.36.0",
    "pg": "^8.20.0",
    "pinyin-pro": "^3.28.2",
    "pizzip": "^3.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "recharts": "^3.8.1",
    "swr": "^2.4.2",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
