// ── 党员关系转接 ─────────────────────────────────────────────────

/// 党员组织关系转接申请记录
model PartyTransferRecord {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  userName         String   @map("user_name")
  transferType     String   @map("transfer_type")   // 转入申请 / 转出申请
  currentStage     String   @default("档案上传") @map("current_stage")
  /// DRAFT / SUBMITTED / REJECTED / COMPLETED
  /// 多级审批: STAGE1_SUBMITTED / STAGE1_REJECTED / STAGE1_COMPANY_APPROVED / STAGE1_COMMITTEE_APPROVED
  status           String   @default("DRAFT")
  /// 上传材料 JSON: { "入党申请书": [{name, url, status?, rejectReason?}], ... }
  materials        Json     @default("{}")
  /// 草稿快照：存储所有步骤的表单状态
  draftData        Json?    @map("draft_data")
  /// 驳回原因（审核员填写）
  rejectReason     String?  @db.Text @map("reject_reason")
  /// 目标党支部名称
  targetBranchName String?  @map("target_branch_name")
  /// 申请人真实姓名
  realName         String?  @map("real_name")
  /// 申请人身份证号
  idCardNumber     String?  @map("id_card_number")
  /// 党费问卷数据: { phone, feeBaseType, feeBaseValue, calculatedFee, receiptOcrPassed, receiptUrl }
  partyFeeData     Json?    @map("party_fee_data")
  /// 阶段4信息采集台账数据
  collectedInfo    Json?    @map("collected_info")
  /// 员工是否发起了修改台账的申请
  stage4ModifyRequested Boolean @default(false) @map("stage4_modify_requested")
  /// 员工是否发起了阶段一撤回请求（需管理员同意后才重置为 DRAFT）
  stage1WithdrawRequested Boolean @default(false) @map("stage1_withdraw_requested")
  /// 驳回历史记录 JSON 数组
  /// 结构: [{round, rejectedAt, files: [{category, fileName, reason}]}]
  rejectionHistory Json?    @map("rejection_history")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("party_transfer_records")
}

/// 党员组织关系转出申请
model PartyTransferOutRequest {
  id              String   @id @default(cuid())
  /// 一人同一时间只能有一个转出申请
  userId          String   @unique @map("user_id")
  /// 姓名（从台账或 User 表提取）
  name            String?
  /// 接收方党委抬头
  targetCommittee String?  @map("target_committee")
  /// 具体转入党组织名称
  targetBranch    String?  @map("target_branch")
  /// 申请原因
  reason          String?  @db.Text
  /// DRAFT / SUBMITTED / APPROVED / REJECTED
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("party_transfer_out_requests")
}

