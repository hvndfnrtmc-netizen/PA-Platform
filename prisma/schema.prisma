/// 公司级表：关联 TalentProject
model TalentProjectCompany {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  name        String                          // 公司名称
  unifiedCode String?   @map("unified_code")  // 统一社会信用代码
  sortOrder   Int       @default(0) @map("sort_order")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project TalentProject        @relation("ProjectCompanies", fields: [projectId], references: [id], onDelete: Cascade)
  cycles  TalentProjectCycle[] @relation("CompanyCycles")

  @@index([projectId])
  @@map("talent_project_companies")
}

/// 周期级表：关联 TalentProjectCompany
model TalentProjectCycle {
  id               String    @id @default(cuid())
  companyId        String    @map("company_id")
  name             String                            // 周期名称，如 "2024年5月"
  windowStartDate  DateTime? @map("window_start_date")
  windowEndDate    DateTime? @map("window_end_date")
  declarationNodes Json      @default("[]") @map("declaration_nodes")  // 当前周期的节点进度
  totalFunding     Decimal?  @db.Decimal(15, 2) @map("total_funding")  // 本期覆盖资金
  headcount        Int?                              // 本期覆盖人数
  ownerId          String?   @map("owner_id")        // 责任人 ID
  feishuGroupUrl   String?   @map("feishu_group_url") // 本周期飞书沟通群链接
  sortOrder        Int       @default(0) @map("sort_order")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company  TalentProjectCompany @relation("CompanyCycles",  fields: [companyId], references: [id], onDelete: Cascade)
  owner    User?                @relation("CycleOwner",     fields: [ownerId],   references: [id])
  tasks    TalentCycleTask[]    @relation("CycleTasks")
  awardees TalentAwardee[]      @relation("CycleAwardees")

  @@index([companyId])
  @@map("talent_project_cycles")
}

/// 申报周期待办任务
model TalentCycleTask {
  id          String   @id @default(cuid())
  cycleId     String   @map("cycle_id")
  content     String
  isCompleted Boolean  @default(false) @map("is_completed")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cycle TalentProjectCycle @relation("CycleTasks", fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
  @@map("talent_cycle_tasks")
}

/// 申报周期入选人员名单
model TalentAwardee {
  id             String   @id @default(cuid())
  cycleId        String   @map("cycle_id")
  batch          String   @default("")          // 批次，如 "第一批"
  name           String                          // 姓名
  feishuOpenId   String?  @map("feishu_open_id") // 飞书 open_id，用于发起聊天
  subsidy        Decimal? @db.Decimal(15, 2)     // 补贴金额（元，旧字段保留兼容）
  approvedAmount Decimal? @db.Decimal(15, 2) @map("approved_amount") // 总核准金额（元）
  status         String   @default("待确认")     // 待确认 / 已通过 / 已拨付
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  cycle         TalentProjectCycle @relation("CycleAwardees", fields: [cycleId], references: [id], onDelete: Cascade)
  disbursements FundDisbursement[] @relation("AwardeeDisbursements")

  @@index([cycleId])
  @@map("talent_awardees")
}

/// 资金拨付流水（支持跨年分期）
model FundDisbursement {
  id           String    @id @default(cuid())
  awardeeId    String    @map("awardee_id")
  trancheName  String    @map("tranche_name")                        // 如"第一期/2024年度"
  amount       Decimal   @db.Decimal(15, 2)                          // 本期金额（元）
  expectedDate DateTime? @map("expected_date")                       // 预计到账时间
  isReceived   Boolean   @default(false) @map("is_received")         // 是否已到账
  receivedDate DateTime? @map("received_date")                       // 实际到账时间
  remark       String?                                                // 备注
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  awardee TalentAwardee @relation("AwardeeDisbursements", fields: [awardeeId], references: [id], onDelete: Cascade)

  @@index([awardeeId])
  @@map("fund_disbursements")
}

// ── 落地协议月度数据（v2）───────────────────────────────────────────────────

/// 月度数据录入：每个 (period, category) 对应一行，payload 存 JSON
model AgreementData {
  id          String    @id @default(cuid())
  period      String    // "YYYY-MM"，如 "2024-06"
  category    String    // finance / hr / ip
  payload     Json      @default("{}")
  submittedBy String?   @map("submitted_by")
  lockedAt    DateTime? @map("locked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([period, category])
  @@map("agreement_data")
}

/// 12 项质性履约义务
model QualitativeObligation {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  articleRef   String   @map("article_ref")
  requirement  String   @db.Text
  status       String   @default("pending")  // compliant / in_progress / pending / at_risk
  description  String?  @db.Text
  evidenceUrls Json     @default("[]") @map("evidence_urls")
  updatedById  String?  @map("updated_by_id")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("qualitative_obligations")
}

/// 协议原件及相关附件（base64 存 DB）
model AgreementFile {
  id         String   @id @default(cuid())
  name       String
  url        String?
  data       String?  @db.Text
  size       Int?
  mimeType   String?  @map("mime_type")
  category   String   @default("other")  // contract / supplement / audit / report / other
  year       Int?
  remark     String?
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("agreement_files")
}
